{
  "$schema": "vscode://schemas/color-theme",
  "name": "Moon Mono Dark",
  "type": "dark",
  "colors": {
    "activityBar.background": "#000000",
    "activityBar.border": "#0a0a0a",
    "activityBar.foreground": "#b0b0b0",
    "activityBarBadge.background": "#ffffff",
    "activityBarBadge.foreground": "#000000",
    "badge.background": "#ffffff",
    "badge.foreground": "#000000",
    "button.background": "#666666",
    "button.foreground": "#ffffff",
    "contrastBorder": "#00000000",
    "debugToolBar.background": "#0a0a0a",
    "diffEditor.insertedTextBackground": "#ffffff19",
    "diffEditor.removedTextBackground": "#99999919",
    "dropdown.background": "#0a0a0a",
    "dropdown.border": "#1a1a1a",
    "dropdown.foreground": "#ffffff",
    "editor.background": "#000000",
    "editor.findMatchBackground": "#cccccc99",
    "editor.findMatchHighlightBackground": "#cccccc4c",
    "editor.focusedStackFrameHighlightBackground": "#99999999",
    "editor.foreground": "#e0e0e0",
    "editor.lineHighlightBackground": "#8888880c",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#8888884c",
    "editor.selectionForeground": "#ffffff",
    "editor.selectionHighlightBorder": "#00000000",
    "editor.stackFrameHighlightBackground": "#9999994c",
    "editor.wordHighlightBackground": "#88888826",
    "editor.wordHighlightStrongBackground": "#8888884c",
    "editorBracketMatch.background": "#8888884c",
    "editorBracketMatch.border": "#00000000",
    "editorCursor.foreground": "#cccccc",
    "editorError.foreground": "#999999",
    "editorGroup.border": "#0a0a0a",
    "editorGroupHeader.tabsBackground": "#000000",
    "editorGroupHeader.tabsBorder": "#0a0a0a",
    "editorGutter.addedBackground": "#e0e0e0",
    "editorGutter.deletedBackground": "#999999",
    "editorGutter.modifiedBackground": "#cccccc",
    "editorIndentGuide.background1": "#0f0f0f",
    "editorLineNumber.activeForeground": "#b0b0b0",
    "editorLineNumber.foreground": "#333333",
    "editorLink.activeForeground": "#cccccc",
    "editorOverviewRuler.addedForeground": "#00000000",
    "editorOverviewRuler.border": "#00000000",
    "editorOverviewRuler.bracketMatchForeground": "#8888884c",
    "editorOverviewRuler.errorForeground": "#999999",
    "editorOverviewRuler.findMatchForeground": "#cccccc99",
    "editorOverviewRuler.modifiedForeground": "#cccccc",
    "editorOverviewRuler.selectionHighlightForeground": "#8888884c",
    "editorOverviewRuler.warningForeground": "#b0b0b0",
    "editorOverviewRuler.wordHighlightForeground": "#88888826",
    "editorOverviewRuler.wordHighlightStrongForeground": "#8888884c",
    "editorRuler.foreground": "#0f0f0f",
    "editorSuggestWidget.foreground": "#e0e0e0",
    "editorWarning.foreground": "#b0b0b0",
    "editorWidget.background": "#0a0a0a",
    "editorWidget.border": "#1a1a1a",
    "errorForeground": "#999999",
    "extensionButton.prominentBackground": "#666666",
    "extensionButton.prominentForeground": "#ffffff",
    "extensionButton.prominentHoverBackground": "#777777",
    "focusBorder": "#1a1a1a",
    "foreground": "#e0e0e0",
    "gitDecoration.ignoredResourceForeground": "#666666",
    "gitDecoration.modifiedResourceForeground": "#cccccc",
    "gitDecoration.untrackedResourceForeground": "#b0b0b0",
    "input.background": "#0a0a0a",
    "input.border": "#1a1a1a",
    "input.foreground": "#e0e0e0",
    "input.placeholderForeground": "#666666",
    "list.activeSelectionBackground": "#ffffff",
    "list.activeSelectionForeground": "#000000",
    "list.dropBackground": "#8888884c",
    "list.focusBackground": "#88888826",
    "list.focusForeground": "#e0e0e0",
    "list.highlightForeground": "#ffffff",
    "list.hoverBackground": "#0a0a0a",
    "list.inactiveSelectionBackground": "#0a0a0a",
    "list.inactiveSelectionForeground": "#e0e0e0",
    "panel.background": "#000000",
    "panel.border": "#00000000",
    "panelTitle.activeBorder": "#b0b0b0",
    "peekView.border": "#ffffff",
    "peekViewEditor.background": "#00000000",
    "peekViewEditor.matchHighlightBackground": "#cccccc99",
    "peekViewResult.background": "#00000000",
    "peekViewResult.fileForeground": "#999999",
    "peekViewResult.lineForeground": "#999999",
    "peekViewResult.matchHighlightBackground": "#cccccc99",
    "peekViewResult.selectionBackground": "#ffffff",
    "peekViewResult.selectionForeground": "#000000",
    "peekViewTitle.background": "#00000000",
    "peekViewTitleDescription.foreground": "#b0b0b0",
    "peekViewTitleLabel.foreground": "#ffffff",
    "progressBar.background": "#666666",
    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#66666619",
    "scrollbarSlider.hoverBackground": "#888888",
    "sideBar.background": "#000000",
    "sideBar.foreground": "#999999",
    "sideBarSectionHeader.background": "#0a0a0a",
    "sideBarSectionHeader.foreground": "#999999",
    "sideBarTitle.foreground": "#b0b0b0",
    "statusBar.background": "#ffffff",
    "statusBar.debuggingBackground": "#b0b0b0",
    "statusBar.debuggingForeground": "#000000",
    "statusBar.foreground": "#9a9a9a",
    "statusBar.noFolderBackground": "#ffffff",
    "tab.activeBackground": "#ffffff",
    "tab.activeForeground": "#000000",
    "tab.activeModifiedBorder": "#00000000",
    "tab.border": "#0a0a0a",
    "tab.inactiveBackground": "#00000000",
    "tab.inactiveForeground": "#666666",
    "tab.inactiveModifiedBorder": "#cccccc",
    "terminal.ansiBlack": "#000000",
    "terminal.ansiBlue": "#888888",
    "terminal.ansiBrightBlack": "#1a1a1a",
    "terminal.ansiBrightBlue": "#aaaaaa",
    "terminal.ansiBrightCyan": "#cccccc",
    "terminal.ansiBrightGreen": "#e0e0e0",
    "terminal.ansiBrightMagenta": "#bbbbbb",
    "terminal.ansiBrightRed": "#999999",
    "terminal.ansiBrightWhite": "#ffffff",
    "terminal.ansiBrightYellow": "#d0d0d0",
    "terminal.ansiCyan": "#b0b0b0",
    "terminal.ansiGreen": "#cccccc",
    "terminal.ansiMagenta": "#999999",
    "terminal.ansiRed": "#888888",
    "terminal.ansiWhite": "#e0e0e0",
    "terminal.ansiYellow": "#b0b0b0",
    "terminal.foreground": "#e0e0e0",
    "terminal.selectionBackground": "#8888884c",
    "terminalCursor.foreground": "#cccccc",
    "textLink.activeForeground": "#cccccc",
    "textLink.foreground": "#b0b0b0",
    "titleBar.activeBackground": "#000000",
    "titleBar.activeForeground": "#999999",
    "titleBar.inactiveBackground": "#000000",
    "titleBar.inactiveForeground": "#666666",
    "widget.shadow": "#00000000",
    "titleBar.border": "#0a0a0a",
    "sideBar.border": "#0a0a0a"
  },
  "tokenColors": [
    {
      "scope": ["comment", "string.quoted.docstring"],
      "settings": {
        "foreground": "#666666"
      }
    },
    {
      "scope": ["string"],
      "settings": {
        "foreground": "#999999"
      }
    },
    {
      "scope": ["punctuation.definition.string", "storage.type.string.python"],
      "settings": {
        "foreground": "#e0e0e0"
      }
    },
    {
      "scope": [
        "beginning.punctuation",
        "entity.name.section.group-title",
        "entity.name.tag",
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id",
        "keyword.const",
        "keyword.control",
        "keyword.function",
        "keyword.import",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.decrement",
        "keyword.operator.expression",
        "keyword.operator.increment",
        "keyword.operator.increment-decrement",
        "keyword.operator.logical",
        "keyword.operator.misc",
        "keyword.operator.new",
        "keyword.operator.other",
        "keyword.operator.ternary",
        "keyword.other.fn",
        "keyword.other.rust",
        "keyword.other.special-method",
        "keyword.other.where",
        "keyword.package",
        "keyword.type",
        "keyword.var",
        "markup.heading",
        "meta.tag.sgml.doctype.html",
        "punctuation.separator.key-value",
        "storage.modifier",
        "storage.type.class",
        "storage.type.enum",
        "storage.type.function",
        "storage.type.import",
        "storage.type.interface",
        "storage.type.js",
        "storage.type.namespace",
        "storage.type.property",
        "storage.type.rust",
        "storage.type.string.python",
        "storage.type.ts",
        "storage.type.tsx",
        "storage.type.type",
        "support.type.object.module"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": "token.info-token",
      "settings": {
        "foreground": "#b0b0b0"
      }
    },
    {
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#999999"
      }
    },
    {
      "scope": "token.error-token",
      "settings": {
        "foreground": "#888888"
      }
    },
    {
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#aaaaaa"
      }
    }
  ]
}
